{
  "name": "file_compress",
  "label": "文件压缩",
  "description": "使用 Gzip 流式压缩文件，支持将目录递归打包为 tar.gz，纯 Zig 实现，无需外部命令",
  "version": "0.3.1",
  "author": "BKLockly",
  "risk_level": "low",
  "platforms": [
    "linux"
  ],
  "methods": [
    {
      "name": "compress",
      "label": "文件压缩",
      "description": "将文件流式压缩为 .gz 格式（支持任意大小文件）",
      "params": [
        {
          "name": "source_path",
          "type": "text",
          "label": "源文件",
          "required": true,
          "description": "要压缩的文件路径"
        },
        {
          "name": "target_path",
          "type": "text",
          "label": "目标路径",
          "required": true,
          "description": "输出的 .gz 文件路径"
        },
        {
          "name": "level",
          "type": "select",
          "label": "压缩级别",
          "required": false,
          "options": [
            { "label": "最快 (level 1)", "value": "fastest" },
            { "label": "默认 (level 6)", "value": "default" },
            { "label": "最小 (level 9)", "value": "best" }
          ],
          "description": "gzip 压缩级别，默认 default"
        }
      ]
    },
    {
      "name": "compressDir",
      "label": "目录打包",
      "description": "将整个目录递归打包为 .tar.gz（流式，保留权限与符号链接，跳过管道/套接字/设备文件）",
      "params": [
        {
          "name": "source_path",
          "type": "text",
          "label": "源目录",
          "required": true,
          "description": "要打包的目录路径"
        },
        {
          "name": "target_path",
          "type": "text",
          "label": "目标路径",
          "required": true,
          "description": "输出的 .tar.gz 文件路径"
        },
        {
          "name": "level",
          "type": "select",
          "label": "压缩级别",
          "required": false,
          "options": [
            { "label": "最快 (level 1)", "value": "fastest" },
            { "label": "默认 (level 6)", "value": "default" },
            { "label": "最小 (level 9)", "value": "best" }
          ],
          "description": "gzip 压缩级别，默认 fastest（打包偏重传输速度）"
        }
      ]
    }
  ]
}
